<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand colours; also the adaptive-icon background. -->
    <color name="ic_launcher_background">#0B1220</color>
    <color name="brand_primary">#3DDC97</color>

    <!--
      Compose renders the whole UI, so the platform theme only has to provide a
      sane window background before the first frame and a matching status-bar
      appearance. No AppCompat parent: this is a pure ComponentActivity app.
    -->
    <style name="Theme.KeyProxy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
