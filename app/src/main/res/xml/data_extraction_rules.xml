<?xml version="1.0" encoding="utf-8"?>
<!--
  data_extraction_rules.xml (API 31+)

  Mirrors backup_rules.xml for the modern backup/transfer path: exclude all
  private app data so no ciphertext or Tink keyset ever leaves the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
